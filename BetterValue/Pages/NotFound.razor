@page "/404"
@page "/notfound"

<PageTitle>404 - Sidan hittades inte</PageTitle>

<div class="container text-center py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 p-5 border rounded shadow-sm bg-light">
            <h1 class="display-1 fw-bold text-danger mb-3">404</h1>
            <h3 class="mb-4">Hoppsan! Sidan kunde inte hittas.</h3>
            <p class="text-muted mb-4 fs-5">
                Det verkar som att du har hamnat på en adress som inte existerar, eller så har sidan flyttats. Kanske en snedspark i URL:en?
            </p>
            <a href="/" class="btn btn-primary btn-lg px-4">
                Tillbaka till startsidan
            </a>
        </div>
    </div>
</div>